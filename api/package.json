{
  "name": "ngi-admissions-api",
  "version": "1.0.0",
  "private": true,
  "description": "NGI Admissions landing page API — Express + Mongoose (Atlas)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "build": "echo \"No build step required\"",
    "dev": "nodemon src/server.js",
    "seed": "node src/seed.js",
    "digest": "node src/jobs/weeklyDigest.js",
    "digest:schedule": "node src/jobs/weeklyDigest.js --schedule",
    "test": "mocha --exit --timeout 90000 --file test/setup.js test/**/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "nodemailer": "^10.0.14"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "mocha": "^12.0.3",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.3.1"
  }
}
