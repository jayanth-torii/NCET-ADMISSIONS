# Copy to .env and fill in your Atlas credentials.
PORT=4005
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.lhejjrt.mongodb.net/ngi_admissions?retryWrites=true&w=majority

# Comma-separated list of browser origins allowed to POST applications.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# --- Weekly admissions digest (every Saturday) ---
# PREFERRED: SMTP, because it is the only transport that can attach the Excel
# workbook. Any mail provider with SMTP access works (Gmail app password,
# Zoho, SendGrid, SES...).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=NGI Admissions <admissionsap@ncetmail.com>

# FALLBACK: EmailJS sends the HTML body but CANNOT attach files. Used only when
# SMTP is not configured and DIGEST_TRANSPORT is not forced.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=

# smtp (default when configured) | emailjs | auto
DIGEST_TRANSPORT=auto

# Link to your admissions desk, included in the digest CTA.
DASHBOARD_URL=http://localhost:3000/

# --- Developer admin panel (/admin) ---
# The password is stored as a bcrypt hash, never in plaintext.
# Generate one with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_EMAIL=jayanth.m@ncetmail.com
ADMIN_PASSWORD_HASH=
ADMIN_OTP=000000
ADMIN_JWT_SECRET=change-me-to-a-long-random-string
ADMIN_JWT_EXPIRES_IN=8h
ADMIN_MAX_ATTEMPTS=5
ADMIN_ATTEMPT_WINDOW_MS=600000
